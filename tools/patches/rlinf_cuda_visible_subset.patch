--- a/rlinf/scheduler/hardware/accelerators/nvidia_gpu.py
+++ b/rlinf/scheduler/hardware/accelerators/nvidia_gpu.py
@@ -387,6 +387,18 @@ class NvidiaGPUManager(AcceleratorManager):
         Returns:
             Dict[str, str]: A dictionary containing the accelerator environment variables.
         """
+        # Placement ranks are local to the GPUs visible to the launcher.  Ray
+        # workers, however, interpret a newly assigned CUDA_VISIBLE_DEVICES
+        # against the physical host.  Translate local ranks back through the
+        # launcher's mask so a parent mask such as ``1,2`` remains physical
+        # GPUs 1 and 2 instead of being rewritten to physical GPUs 0 and 1.
+        parent_visible = NvidiaGPUManager.get_visible_devices()
+        if parent_visible:
+            local_ranks = [int(value) for value in visible_accelerators]
+            if all(0 <= rank < len(parent_visible) for rank in local_ranks):
+                visible_accelerators = [
+                    str(parent_visible[rank]) for rank in local_ranks
+                ]
         env_vars = {}
         visible_accelerators_str = ",".join(visible_accelerators)
 
