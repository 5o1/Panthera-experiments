+    def _continuous_prediction(
+        self,
+        multimodal_embeddings,
+        multimodal_attention_mask,
+        multimodal_position_ids,
+        num_patches,
+        num_prompt_tokens,
+    ):
+        """Run the separately trained OpenVLA-OFT L1 action head."""
+        language_model_output = self.language_model(
+            input_ids=None,
+            attention_mask=multimodal_attention_mask,
+            position_ids=multimodal_position_ids,
+            past_key_values=None,
+            inputs_embeds=multimodal_embeddings,
+            labels=None,
+            use_cache=None,
+            output_attentions=False,
+            output_hidden_states=True,
+            return_dict=True,
+        )
+        last_hidden_states = language_model_output.hidden_states[-1]
+        batch_size = last_hidden_states.shape[0]
+        device = last_hidden_states.device
+        start_indices = (num_patches + num_prompt_tokens).unsqueeze(1)
+        position_offsets = torch.arange(
+            self.action_dim * self.num_action_chunks, device=device
+        ).unsqueeze(0)
+        seq_indices = start_indices + position_offsets
+        action_hidden_states = last_hidden_states[
+            torch.arange(batch_size, device=device).unsqueeze(-1), seq_indices, :
+        ]
+        normalized_actions = self.action_head.predict_action(action_hidden_states)
+        expected_shape = (
+            batch_size,
+            self.num_action_chunks,
+            self.action_dim,
+        )
+        if tuple(normalized_actions.shape) != expected_shape:
+            raise ValueError(
+                "continuous action head returned "
+                f"{tuple(normalized_actions.shape)}, expected {expected_shape}"
+            )
+        action_tokens = torch.zeros(
+            (batch_size, self.action_dim * self.num_action_chunks),
+            dtype=torch.long,
+            device=device,
+        )
+        return (
+            normalized_actions.float().cpu().numpy(),
+            action_tokens,
+            last_hidden_states,
+        )
+
