     def set_planner(self, scene=None):
+        # Upstream dropped the mplib branch from this method between 0008ae6
+        # and 6dde571 and now always builds a CuroboPlanner.  The capability
+        # is still there -- MplibPlanner and the scene-backed
+        # SapienPlanningWorld both remain in planner.py -- only the dispatch
+        # went away.  Restoring it keeps an embodiment that declares
+        # ``planner: mplib_*`` on the planner its results were measured with;
+        # switching to curobo would be a separate decision that invalidates
+        # the expert-replay baseline.
+        planner_type = str(getattr(self, "left_planner_type", "curobo"))
+        if planner_type.startswith("mplib"):
+            self.communication_flag = False
+            for side in ("left", "right"):
+                entity = getattr(self, f"{side}_entity")
