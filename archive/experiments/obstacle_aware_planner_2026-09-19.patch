@@ -361,6 +409,88 @@ class place_cylinder_in_groove(Base_Task):
             np.concatenate((actions, actions), axis=1), action_type=action_type
         )

+    # Commanded gripper opening below which the oracle is holding something.
+    # Physical contact count is not usable here: the planner works on convex
+    # hulls and reported zero SAPIEN contacts while the finger hull overlapped
+    # the cylinder.  This is the same threshold the dense executor uses.
+    GRASP_CLOSED_OPENING = 0.5
+
+    def _sync_planner_world(self):
+        """Refresh object poses, and attach or detach the held cylinder.
+
+        ``SapienPlanningWorld`` is a snapshot.  Poses go stale as soon as
+        anything moves, and a grasped object stays behind in the world as an
+        obstacle the gripper is permanently inside of.  Attaching it hands the
+        object to the gripper's kinematics and allows the finger contacts;
+        detaching on release puts it back as an obstacle.
+        """
+        holding = (
+            float(self.robot.get_left_gripper_val()) < self.GRASP_CLOSED_OPENING
+        )
+        for planner in self._scene_backed_planners():
+            world = planner.planning_world
+            world.update_from_simulation(update_attached_object=True)
+            name = self._planner_cylinder_name(world)
+            if name is None:
+                continue
+            if holding and not self._planner_cylinder_attached:
+                world.attach_object(
+                    name,
+                    self._planner_articulation_name(world),
+                    self._planner_gripper_link_id(planner),
+                    list(planner.user_link_names),
+                )
+                self._set_carried_contact(planner, name, True)
+            elif not holding and self._planner_cylinder_attached:
+                world.detach_object(name)
+                self._set_carried_contact(planner, name, False)
+        self._planner_cylinder_attached = holding
+
+    def _set_carried_contact(self, planner, cylinder_name, allowed):
+        """Stop collision-checking a cylinder that is already in the gripper.
+
+        What this change is worth is entirely in the approach, where the
+        planner used to route through a cylinder it did not know existed.  Once
+        the cylinder is held, re-imposing those checks only rejects routes that
+        physically work: the measured rejections were the cylinder resting on
+        the table it was lifted from, the backdrop wall, and ``base_link``,
+        ``link1`` and ``link2`` during the lying reorientation -- convex-hull
+        artefacts of an arm that carries objects close to its own body.  The
+        collection oracle's routes were designed without this check and are the
+        baseline, so honouring it here would change behaviour that works.
+        """
+        for other in planner.planning_world.get_object_names():
+            if other != cylinder_name:
+                planner.acm.set_entry(cylinder_name, other, allowed)
+
+    def _scene_backed_planners(self):
+        for side in ("left_planner", "right_planner"):
+            wrapper = getattr(self.robot, side, None)
+            planner = getattr(wrapper, "planner", None)
+            if planner is not None and hasattr(planner, "planning_world"):
+                yield planner
+
+    @staticmethod
+    def _planner_cylinder_name(world):
+        for name in world.get_object_names():
+            if name.startswith("panthera_cylinder"):
+                return name
+        return None
+
+    @staticmethod
+    def _planner_articulation_name(world):
+        names = list(world.get_articulation_names())
+        if len(names) != 1:
+            raise ValueError(f"expected one planned articulation, got {names}")
+        return names[0]
+
+    @staticmethod
+    def _planner_gripper_link_id(planner):
+        links = list(planner.user_link_names)
+        if "gripper_center" not in links:
+            raise ValueError(f"no gripper_center link among {links}")
+        return links.index("gripper_center")
+
     def _move_arm(self, action, stage: str) -> bool:
         """Execute one single-arm action group and retain its milestone frame."""
