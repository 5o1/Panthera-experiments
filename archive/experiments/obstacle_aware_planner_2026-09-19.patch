+    def _give_planner_the_task_objects(self):
+        """Rebuild the motion planner now that the cylinder and socket exist.
+
+        ``_init_task_env_`` builds the planner inside ``setup_scene``, which
+        runs before ``load_actors``.  ``SapienPlanningWorld`` snapshots the
+        scene at construction, so the planning world held only the table, the
+        wall and the ground, and ``update_from_simulation`` cannot help -- it
+        refreshes the poses of objects already in the world, it does not add
+        new ones.  Every path was therefore planned across an empty table.
+
+        From the home pose the top-down grasp happens to descend vertically and
+        misses the cylinder; from any other start the planner routes straight
+        through where the cylinder actually is.  Measured on sixteen lying
+        scenes diverged by two hundred expert steps, oracle takeover succeeded
+        2/16, and the failures rolled the cylinder a median 114 degrees during
+        the approach.  Upright survived (15/16) only because a top-down grasp
+        on a standing cylinder is symmetric about the vertical axis.
+        """
+        self.robot.set_planner(self.scene)
+        self._planner_cylinder_attached = False
+        self._plan_against_the_current_world()
+
+    def _plan_against_the_current_world(self):
+        """Route every plan through :meth:`_sync_planner_world`.
+
+        Three places plan a path: ``_base_task.move`` and the two direct
+        ``left_plan_path`` calls on the continuous-motion route.  Hooking
+        ``move`` covered only the first, and the route's own calls went to a
+        stale world -- which is how a grasped cylinder still read as an
+        obstacle the fingers were inside of.  The robot's planning entry point
+        is where all of them meet, so it is the only hook that cannot be
+        bypassed by a fourth call site appearing later.
+        """
+        for side in ("left_plan_path", "right_plan_path"):
+            bound = getattr(self.robot, side, None)
+            if bound is None:
+                continue
+            original = getattr(bound, "_panthera_unsynced", bound)
+
+            def wrapper(*args, _original=original, **kwargs):
+                self._sync_planner_world()
+                return _original(*args, **kwargs)
+
+            wrapper._panthera_unsynced = original
+            setattr(self.robot, side, wrapper)
+
     def load_actors(self):
         """Create a horizontal dynamic cylinder and a static U-shaped target groove."""
